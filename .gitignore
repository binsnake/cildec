# Build output
target/
debug/
fuzz/target/
fuzz/logs/

# MSBuild output from the fixture and tool projects
**/bin/
**/obj/

# rustfmt backups and MSVC debug information
**/*.rs.bk
*.pdb

# cargo mutants
**/mutants.out*/

# Written by tests/golden.rs and tests/differential.rs when a dump differs
*.actual.txt

# The corpora are committed as one .pack per target; the directories
# libFuzzer reads are generated from them by examples/corpus-pack.rs.
fuzz/corpus/*/
